# MinIO / S3
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ENDPOINT=http://minio:9000
MINIO_REGION=us-east-1

# Kafka (KRaft — sem ZooKeeper)
# Listener INTERNAL: usado por serviços dentro da rede Docker
# Listener EXTERNAL: usado por scripts rodando no host (fora do Docker)
KAFKA_BROKERS=kafka:9093
KAFKA_BROKERS_EXTERNAL=localhost:9092
KAFKA_SCHEMA_REGISTRY=http://schema-registry:8081

# PostgreSQL (Hive Metastore backend)
POSTGRES_USER=hive
POSTGRES_PASSWORD=hive
POSTGRES_DB=metastore

# Hive Metastore
HIVE_METASTORE_URI=thrift://hive-metastore:9083

# Trino
TRINO_HOST=trino
TRINO_PORT=8080

# Superset
SUPERSET_SECRET_KEY=12345ab@
SUPERSET_ADMIN_PASSWORD=admin

# Spark
SPARK_CONNECT_URL=sc://spark-connect:15002

# Caminhos dos dados
# CSV_DIR: usado pelo producer_csv_kafka.py (roda no host ou container dev)
CSV_DIR=./data
# DATA_DIR: usado pelo ingest_csv_to_raw.py (roda dentro do container spark-connect)
DATA_DIR=/opt/spark/work-dir/data
